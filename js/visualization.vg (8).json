{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Ridgeline plot of the age distribution of people using each aged care type, with a Male/Female dropdown. Each ridge shows the percentage of that care type and sex group in each age group; ridges are offset vertically and share one percentage scale. Age groups with no record are not drawn.",
  "background": "#FFFFFF",
  "padding": {"left": 10, "right": 140, "top": 10, "bottom": 10},
  "width": 800,
  "height": 480,
  "title": {
    "text": "At What Age Do Australians Use Different Types of Aged Care?",
    "subtitle": [
      "Age distribution of aged care recipients by service type and sex, Australia, 2025",
      "Each ridge shows the share of that care type's recipients in each age group (baseline = 0%). All ridges use the same scale. Age groups with no record are not drawn."
    ],
    "anchor": "start",
    "font": "Manrope, sans-serif",
    "fontSize": 26,
    "fontWeight": 800,
    "color": "#183B4E",
    "subtitleFont": "Inter, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#64757A",
    "subtitlePadding": 8,
    "offset": 20
  },
  "style": "cell",
  "data": [
    {"name": "hoverPoint_store"},
    {"name": "source_1", "values": [{"age": "100+", "y0": 88, "y1": 98}]},
    {
      "name": "source_2",
      "values": [{"age": "100+", "y": 93, "label": "10 percentage points"}]
    },
    {
      "name": "source_0",
      "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia/refs/heads/main/data/australia_aged_care_by_age_sex_type_2025.csv",
      "format": {
        "type": "csv",
        "parse": {
          "Recipients": "number",
          "PercentageWithinCareTypeSex": "number"
        },
        "delimiter": ","
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Sex !== 'Unknown' && datum.Sex === sexSel"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.PercentageWithinCareTypeSex) && isFinite(datum.PercentageWithinCareTypeSex)"
        },
        {
          "type": "formula",
          "expr": "indexof(['Permanent residential care','Home care','Respite residential care','Short-term restorative care','Transition care'], datum.CareType)",
          "as": "ridgeIdx"
        },
        {"type": "filter", "expr": "datum.ridgeIdx >= 0"},
        {"type": "formula", "expr": "(4 - datum.ridgeIdx) * 18", "as": "base"},
        {
          "type": "formula",
          "expr": "datum.base + datum.PercentageWithinCareTypeSex",
          "as": "top"
        },
        {
          "type": "formula",
          "expr": "format(datum.PercentageWithinCareTypeSex, '.1f') + '%'",
          "as": "pctText"
        },
        {
          "type": "formula",
          "expr": "isValid(datum.Recipients) && isFinite(datum.Recipients) ? format(datum.Recipients, ',.0f') : 'Suppressed'",
          "as": "recipientsText"
        },
        {
          "type": "formula",
          "expr": "indexof(['0–49','50–54','55–59','60–64','65–69','70–74','75–79','80–84','85–89','90–94','95–99','100+'], datum.AgeGroup)",
          "as": "ageIdx"
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.CareType === 'Permanent residential care'"
        }
      ]
    },
    {
      "name": "data_1",
      "source": "source_0",
      "transform": [
        {"type": "filter", "expr": "datum.CareType === 'Home care'"}
      ]
    },
    {
      "name": "data_2",
      "source": "source_0",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.CareType === 'Respite residential care'"
        }
      ]
    },
    {
      "name": "data_3",
      "source": "source_0",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.CareType === 'Short-term restorative care'"
        }
      ]
    },
    {
      "name": "data_4",
      "source": "source_0",
      "transform": [
        {"type": "filter", "expr": "datum.CareType === 'Transition care'"}
      ]
    },
    {
      "name": "data_5",
      "source": "source_0",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"top\"]) && isFinite(+datum[\"top\"])"
        }
      ]
    },
    {
      "name": "data_6",
      "source": "source_0",
      "transform": [
        {"type": "filter", "expr": "datum.AgeGroup === '50–54'"},
        {
          "type": "filter",
          "expr": "isValid(datum[\"base\"]) && isFinite(+datum[\"base\"])"
        }
      ]
    },
    {
      "name": "data_7",
      "source": "source_1",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"y0\"]) && isFinite(+datum[\"y0\"])"
        }
      ]
    },
    {
      "name": "data_8",
      "source": "source_2",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"y\"]) && isFinite(+datum[\"y\"])"
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "unit",
      "value": {},
      "on": [
        {"events": "pointermove", "update": "isTuple(group()) ? group() : unit"}
      ]
    },
    {
      "name": "hoverPoint",
      "update": "vlSelectionResolve(\"hoverPoint_store\", \"union\", true, true)"
    },
    {
      "name": "sexSel",
      "value": "Female",
      "bind": {
        "input": "select",
        "options": ["Female", "Male"],
        "name": "Show sex: "
      }
    },
    {
      "name": "hoverPoint_tuple",
      "on": [
        {
          "events": [{"source": "scope", "type": "pointerover"}],
          "update": "datum && item().mark.marktype !== 'group' && indexof(item().mark.role, 'legend') < 0 ? {unit: \"layer_10\", fields: hoverPoint_tuple_fields, values: [(item().isVoronoi ? datum.datum : datum)[\"CareType\"], (item().isVoronoi ? datum.datum : datum)[\"AgeGroup\"]]} : null",
          "force": true
        },
        {"events": [{"source": "view", "type": "pointerout"}], "update": "null"}
      ]
    },
    {
      "name": "hoverPoint_tuple_fields",
      "value": [
        {"type": "E", "field": "CareType"},
        {"type": "E", "field": "AgeGroup"}
      ]
    },
    {
      "name": "hoverPoint_toggle",
      "value": false,
      "on": [
        {
          "events": [{"source": "scope", "type": "pointerover"}],
          "update": "event.shiftKey"
        },
        {
          "events": [{"source": "view", "type": "pointerout"}],
          "update": "false"
        }
      ]
    },
    {
      "name": "hoverPoint_modify",
      "on": [
        {
          "events": {"signal": "hoverPoint_tuple"},
          "update": "modify(\"hoverPoint_store\", hoverPoint_toggle ? null : hoverPoint_tuple, hoverPoint_toggle ? null : true, hoverPoint_toggle ? hoverPoint_tuple : null)"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "layer_0_pathgroup",
      "type": "group",
      "from": {
        "facet": {
          "name": "faceted_path_layer_0_main",
          "data": "data_0",
          "groupby": ["CareType"]
        }
      },
      "encode": {
        "update": {
          "width": {"field": {"group": "width"}},
          "height": {"field": {"group": "height"}}
        }
      },
      "marks": [
        {
          "name": "layer_0_marks",
          "type": "area",
          "style": ["area"],
          "sort": {"field": "x"},
          "interactive": false,
          "from": {"data": "faceted_path_layer_0_main"},
          "encode": {
            "update": {
              "opacity": {"value": 0.78},
              "stroke": {"value": "#FFFFFF"},
              "strokeWidth": {"value": 1.2},
              "interpolate": {"value": "linear"},
              "orient": {"value": "vertical"},
              "fill": {"scale": "color", "field": "CareType"},
              "description": {
                "signal": "\"Age group (years): \" + (isValid(datum[\"AgeGroup\"]) ? isArray(datum[\"AgeGroup\"]) ? join(datum[\"AgeGroup\"], ' ') : datum[\"AgeGroup\"] : \"\"+datum[\"AgeGroup\"]) + \"; top: \" + (format(datum[\"top\"], \"\")) + \"; base: \" + (format(datum[\"base\"], \"\")) + \"; CareType: \" + (isValid(datum[\"CareType\"]) ? isArray(datum[\"CareType\"]) ? join(datum[\"CareType\"], ' ') : datum[\"CareType\"] : \"\"+datum[\"CareType\"])"
              },
              "x": {"scale": "x", "field": "AgeGroup"},
              "y": {"scale": "y", "field": "top"},
              "y2": {"scale": "y", "field": "base"},
              "defined": {
                "signal": "isValid(datum[\"top\"]) && isFinite(+datum[\"top\"])"
              }
            }
          }
        }
      ]
    },
