{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "100% stacked area chart of Australia's population by age group, 1990 to 2025.",
  "autosize": {"type": "fit-x", "contains": "padding"},
  "background": "#FFFFFF",
  "padding": 5,
  "width": 800,
  "height": 420,
  "title": {
    "text": "Australia's Population Is Getting Older",
    "subtitle": "How Australia's population age structure has changed from 1990 to 2025.",
    "anchor": "start",
    "font": "Manrope, sans-serif",
    "fontSize": 28,
    "fontWeight": 800,
    "color": "#183B4E",
    "subtitleFont": "Inter, sans-serif",
    "subtitleFontSize": 15,
    "subtitleColor": "#64757A",
    "subtitlePadding": 8,
    "offset": 20
  },
  "style": "cell",
  "data": [
    {"name": "hoverYear_store"},
    {
      "name": "source_0",
      "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia/refs/heads/main/data/australia_population_age_groups_1990_2025.csv",
      "format": {
        "type": "csv",
        "parse": {
          "Year": "number",
          "Population": "number",
          "Percentage": "number"
        },
        "delimiter": ","
      },
      "transform": [
        {
          "type": "formula",
          "expr": "datum.AgeGroup === '0–14' ? 0 : datum.AgeGroup === '15–44' ? 1 : datum.AgeGroup === '45–64' ? 2 : datum.AgeGroup === '65–79' ? 3 : 4",
          "as": "ageOrder"
        },
        {
          "type": "stack",
          "groupby": ["Year"],
          "field": "Percentage",
          "sort": {"field": ["ageOrder"], "order": ["ascending"]},
          "as": ["y0", "y1"],
          "offset": "zero"
        },
        {
          "type": "formula",
          "expr": "format(datum.Percentage, '.1f') + '%'",
          "as": "shareText"
        },
        {"type": "formula", "expr": "max(datum.Year - 0.5, 1990)", "as": "xa"},
        {"type": "formula", "expr": "min(datum.Year + 0.5, 2025)", "as": "xb"}
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"Year\"]) && isFinite(+datum[\"Year\"])"
        }
      ]
    },
    {
      "name": "data_1",
      "source": "source_0",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"xa\"]) && isFinite(+datum[\"xa\"]) && isValid(datum[\"y0\"]) && isFinite(+datum[\"y0\"])"
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "unit",
      "value": {},
      "on": [
        {"events": "pointermove", "update": "isTuple(group()) ? group() : unit"}
      ]
    },
    {
      "name": "hoverYear",
      "update": "vlSelectionResolve(\"hoverYear_store\", \"union\", true, true)"
    },
    {
      "name": "hoverYear_tuple",
      "on": [
        {
          "events": [{"source": "scope", "type": "pointerover"}],
          "update": "datum && item().mark.marktype !== 'group' && indexof(item().mark.role, 'legend') < 0 ? {unit: \"layer_2\", fields: hoverYear_tuple_fields, values: [(item().isVoronoi ? datum.datum : datum)[\"Year\"]]} : null",
          "force": true
        },
        {"events": [{"source": "view", "type": "pointerout"}], "update": "null"}
      ]
    },
    {
      "name": "hoverYear_tuple_fields",
      "value": [{"type": "E", "field": "Year"}]
    },
    {
      "name": "hoverYear_toggle",
      "value": false,
      "on": [
        {
          "events": [{"source": "scope", "type": "pointerover"}],
          "update": "event.shiftKey"
        },
        {
          "events": [{"source": "view", "type": "pointerout"}],
          "update": "false"
        }
      ]
    },
    {
      "name": "hoverYear_modify",
      "on": [
        {
          "events": {"signal": "hoverYear_tuple"},
          "update": "modify(\"hoverYear_store\", hoverYear_toggle ? null : hoverYear_tuple, hoverYear_toggle ? null : true, hoverYear_toggle ? hoverYear_tuple : null)"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "layer_0_pathgroup",
      "type": "group",
      "from": {
        "facet": {
          "name": "faceted_path_layer_0_main",
          "data": "source_0",
          "groupby": ["AgeGroup"]
        }
      },
      "encode": {
        "update": {
          "width": {"field": {"group": "width"}},
          "height": {"field": {"group": "height"}}
        }
      },
      "marks": [
        {
          "name": "layer_0_marks",
          "type": "area",
          "style": ["area"],
          "sort": {"field": "x"},
          "interactive": false,
          "from": {"data": "faceted_path_layer_0_main"},
          "encode": {
            "update": {
              "stroke": {"value": "#FFFFFF"},
              "strokeWidth": {"value": 0.8},
              "interpolate": {"value": "monotone"},
              "orient": {"value": "vertical"},
              "fill": {"scale": "color", "field": "AgeGroup"},
              "description": {
                "signal": "\"Year: \" + (format(datum[\"Year\"], \"d\")) + \"; Share of population: \" + (format(datum[\"y0\"], \"\")) + \"; y1: \" + (format(datum[\"y1\"], \"\")) + \"; AgeGroup: \" + (isValid(datum[\"AgeGroup\"]) ? isArray(datum[\"AgeGroup\"]) ? join(datum[\"AgeGroup\"], ' ') : datum[\"AgeGroup\"] : \"\"+datum[\"AgeGroup\"])"
              },
              "x": {"scale": "x", "field": "Year"},
              "y": {"scale": "y", "field": "y0"},
              "y2": {"scale": "y", "field": "y1"},
              "defined": {
                "signal": "isValid(datum[\"Year\"]) && isFinite(+datum[\"Year\"]) && isValid(datum[\"y0\"]) && isFinite(+datum[\"y0\"])"
              }
            }
          }
        }
      ]
    },
    {
      "name": "layer_1_marks",
      "type": "rule",
      "style": ["rule"],
      "interactive": false,
      "from": {"data": "data_0"},
      "encode": {
        "update": {
          "strokeWidth": {"value": 1.5},
          "strokeDash": {"value": [4, 3]},
          "stroke": {"scale": "color", "field": "AgeGroup"},
          "opacity": [
            {
              "test": "length(data(\"hoverYear_store\")) && vlSelectionTest(\"hoverYear_store\", datum)",
              "value": 0.9
            },
            {"value": 0}
          ],
          "description": {
            "signal": "\"Year: \" + (format(datum[\"Year\"], \"\")) + \"; AgeGroup: \" + (isValid(datum[\"AgeGroup\"]) ? isArray(datum[\"AgeGroup\"]) ? join(datum[\"AgeGroup\"], ' ') : datum[\"AgeGroup\"] : \"\"+datum[\"AgeGroup\"])"
          },
          "x": {"scale": "x", "field": "Year"},
          "y": {"value": 0},
          "y2": {"field": {"group": "height"}}
        }
      }
    },
    {
      "name": "layer_2_marks",
      "type": "rect",
      "style": ["rect"],
      "interactive": true,
      "from": {"data": "data_1"},
      "encode": {
        "update": {
          "opacity": {"value": 0},
          "strokeWidth": {"value": 0},
          "fill": {"scale": "color", "field": "AgeGroup"},
          "tooltip": {
            "signal": "{\"Year\": isValid(datum[\"Year\"]) ? isArray(datum[\"Year\"]) ? join(datum[\"Year\"], '\\n') : datum[\"Year\"] : \"\"+datum[\"Year\"], \"Age group\": isValid(datum[\"AgeGroup\"]) ? isArray(datum[\"AgeGroup\"]) ? join(datum[\"AgeGroup\"], '\\n') : datum[\"AgeGroup\"] : \"\"+datum[\"AgeGroup\"], \"People\": format(datum[\"Population\"], \",.0f\"), \"Share of population\": isValid(datum[\"shareText\"]) ? isArray(datum[\"shareText\"]) ? join(datum[\"shareText\"], '\\n') : datum[\"shareText\"] : \"\"+datum[\"shareText\"]}"
          },
          "description": {
            "signal": "\"xa: \" + (format(datum[\"xa\"], \"\")) + \"; y0: \" + (format(datum[\"y0\"], \"\")) + \"; xb: \" + (format(datum[\"xb\"], \"\")) + \"; y1: \" + (format(datum[\"y1\"], \"\")) + \"; AgeGroup: \" + (isValid(datum[\"AgeGroup\"]) ? isArray(datum[\"AgeGroup\"]) ? join(datum[\"AgeGroup\"], ' ') : datum[\"AgeGroup\"] : \"\"+datum[\"AgeGroup\"]) + \"; Year: \" + (isValid(datum[\"Year\"]) ? isArray(datum[\"Year\"]) ? join(datum[\"Year\"], ' ') : datum[\"Year\"] : \"\"+datum[\"Year\"]) + \"; Age group: \" + (isValid(datum[\"AgeGroup\"]) ? isArray(datum[\"AgeGroup\"]) ? join(datum[\"AgeGroup\"], ' ') : datum[\"AgeGroup\"] : \"\"+datum[\"AgeGroup\"]) + \"; People: \" + (format(datum[\"Population\"], \",.0f\")) + \"; Share of population: \" + (isValid(datum[\"shareText\"]) ? isArray(datum[\"shareText\"]) ? join(datum[\"shareText\"], ' ') : datum[\"shareText\"] : \"\"+datum[\"shareText\"])"
          },
          "x": {"scale": "x", "field": "xa"},
          "x2": {"scale": "x", "field": "xb"},
          "y": {"scale": "y", "field": "y0"},
          "y2": {"scale": "y", "field": "y1"}
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": [1990, 2025],
      "range": [0, {"signal": "width"}],
      "nice": false,
      "zero": false
    },
    {
      "name": "y",
      "type": "linear",
      "domain": [0, 100],
      "range": [{"signal": "height"}, 0],
      "nice": true,
      "zero": true
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": ["0–14", "15–44", "45–64", "65–79", "80+"],
      "range": ["#B7D8D2", "#79B7AE", "#3D8C87", "#E4A58D", "#C76F63"],
      "interpolate": "hcl"
    }
  ],
  "axes": [
    {
      "scale": "y",
      "orient": "left",
      "grid": true,
      "values": [0, 20, 40, 60, 80, 100],
      "gridScale": "x",
      "tickCount": {"signal": "ceil(height/40)"},
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "Year",
      "format": "d",
      "values": [1990, 1995, 2000, 2005, 2010, 2015, 2020, 2025],
      "labelFlush": true,
      "labelOverlap": true,
      "tickCount": {"signal": "ceil(width/40)"},
      "tickMinStep": 1,
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "Share of population",
      "values": [0, 20, 40, 60, 80, 100],
      "labelOverlap": true,
      "tickCount": {"signal": "ceil(height/40)"},
      "encode": {
        "labels": {"update": {"text": {"signal": "datum.value + '%'"}}}
      },
      "zindex": 0
    }
  ],
  "legends": [
    {
      "columnPadding": 18,
      "direction": "horizontal",
      "labelColor": "#183B4E",
      "labelFontSize": 13,
      "offset": 14,
      "orient": "top",
      "symbolSize": 140,
      "symbolType": "square",
      "fill": "color",
      "encode": {"symbols": {"update": {}}},
      "stroke": "color"
    }
  ],
  "config": {
    "axis": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif",
      "labelColor": "#64757A",
      "titleColor": "#64757A",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 500,
      "titlePadding": 12,
      "domain": false,
      "gridColor": "#E9E5DB",
      "tickColor": "#E9E5DB",
      "tickSize": 5
    },
    "style": {
      "guide-label": {"font": "Inter, sans-serif"},
      "guide-title": {"font": "Inter, sans-serif"},
      "group-title": {"font": "Inter, sans-serif"},
      "group-subtitle": {"font": "Inter, sans-serif"},
      "cell": {"stroke": null},
      "text": {"font": "Inter, sans-serif"}
    }
  }
}
